{
  "name": "vscode-fhir-connect",
  "displayName": "FHIRConnect",
  "description": "Editing support for FHIRConnect openEHR <-> FHIR mapping files: validation, completion, navigation, and path resolution against openEHR templates and FHIR R4.",
  "version": "0.3.0",
  "publisher": "damoca",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/damoca/vscode-fhir-connect.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "FHIRConnect",
    "FHIR",
    "openEHR",
    "mapping",
    "yaml"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fhirconnect.newMapping",
        "title": "New Mapping File",
        "category": "FHIRConnect"
      },
      {
        "command": "fhirconnect.goToArchetype",
        "title": "Go to Archetype Definition",
        "category": "FHIRConnect"
      },
      {
        "command": "fhirconnect.peekArchetype",
        "title": "Peek Archetype Definition",
        "category": "FHIRConnect"
      }
    ],
    "configuration": {
      "title": "FHIRConnect",
      "properties": {
        "fhirconnect.validation.enable": {
          "type": "boolean",
          "default": true,
          "description": "Report FHIRConnect grammar problems (unknown keys, missing required keys, invalid values) in mapping files."
        },
        "fhirconnect.validation.paths": {
          "type": "boolean",
          "default": true,
          "description": "Check the FHIR and openEHR paths of mapping files against the FHIR R4 definitions and the operational templates (.opt) of the workspace."
        },
        "fhirconnect.inlayHints.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show what each `with` path resolves to (openEHR node and type, FHIR type) at the end of the line."
        },
        "fhirconnect.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the FHIRConnect language server."
        }
      }
    },
    "keybindings": [
      {
        "command": "fhirconnect.goToArchetype",
        "key": "ctrl+alt+f12",
        "mac": "cmd+alt+f12",
        "when": "editorTextFocus && fhirconnect.isMapping"
      },
      {
        "command": "fhirconnect.peekArchetype",
        "key": "ctrl+shift+alt+f12",
        "mac": "cmd+shift+alt+f12",
        "when": "editorTextFocus && fhirconnect.isMapping"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "fhirconnect.goToArchetype",
          "when": "fhirconnect.isMapping",
          "group": "navigation@1.5"
        }
      ],
      "commandPalette": [
        {
          "command": "fhirconnect.goToArchetype",
          "when": "fhirconnect.isMapping"
        },
        {
          "command": "fhirconnect.peekArchetype",
          "when": "fhirconnect.isMapping"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build -- --production"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-uri": "3.0.8",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
