{
  "name": "vscode-fhir-connect",
  "displayName": "FHIRConnect",
  "description": "Editing support for FHIRConnect openEHR <-> FHIR mapping files: validation, completion, navigation, path resolution against openEHR templates and FHIR R4, and running mappings with openFHIR.",
  "version": "0.5.0",
  "publisher": "veratech-es",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/veratech-es/vscode-fhir-connect.git"
  },
  "bugs": {
    "url": "https://github.com/veratech-es/vscode-fhir-connect/issues"
  },
  "homepage": "https://github.com/veratech-es/vscode-fhir-connect#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "FHIRConnect",
    "FHIR",
    "openEHR",
    "mapping",
    "yaml"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fhirconnect.newMapping",
        "title": "New Mapping File",
        "category": "FHIRConnect"
      },
      {
        "command": "fhirconnect.goToArchetype",
        "title": "Go to Archetype Definition",
        "category": "FHIRConnect"
      },
      {
        "command": "fhirconnect.peekArchetype",
        "title": "Peek Archetype Definition",
        "category": "FHIRConnect"
      },
      {
        "command": "fhirconnect.showMappingContext",
        "title": "Show Mapping Context",
        "category": "FHIRConnect",
        "icon": "$(list-tree)"
      },
      {
        "command": "fhirconnect.refreshMappingContext",
        "title": "Refresh",
        "category": "FHIRConnect",
        "icon": "$(refresh)"
      },
      {
        "command": "fhirconnect.openfhir.runToOpenEhr",
        "title": "Run Mapping to openEHR",
        "category": "FHIRConnect",
        "icon": "$(play)"
      },
      {
        "command": "fhirconnect.openfhir.runToFhir",
        "title": "Run Mapping to FHIR",
        "category": "FHIRConnect",
        "icon": "$(play)"
      },
      {
        "command": "fhirconnect.openfhir.sync",
        "title": "Sync Mappings with openFHIR",
        "category": "FHIRConnect"
      },
      {
        "command": "fhirconnect.openfhir.checkConnection",
        "title": "Check openFHIR Connection",
        "category": "FHIRConnect"
      },
      {
        "command": "fhirconnect.openfhir.setToken",
        "title": "Set openFHIR Token",
        "category": "FHIRConnect"
      }
    ],
    "configuration": {
      "title": "FHIRConnect",
      "properties": {
        "fhirconnect.validation.enable": {
          "type": "boolean",
          "default": true,
          "description": "Report FHIRConnect grammar problems (unknown keys, missing required keys, invalid values) in mapping files."
        },
        "fhirconnect.validation.paths": {
          "type": "boolean",
          "default": true,
          "description": "Check the FHIR and openEHR paths of mapping files against the FHIR R4 definitions and the operational templates (.opt) of the workspace."
        },
        "fhirconnect.inlayHints.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show what each `with` path resolves to (openEHR node and type, FHIR type) at the end of the line."
        },
        "fhirconnect.openfhir.url": {
          "type": "string",
          "default": "http://localhost:8080",
          "markdownDescription": "Base URL of the openFHIR engine (3.0.3 or later) that runs the mappings, e.g. `http://localhost:8080`."
        },
        "fhirconnect.openfhir.syncOnSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Make openFHIR reload its bootstrap folder (`POST /$bootstrap`) when a mapping file or an operational template inside `#fhirconnect.openfhir.bootstrapFolder#` is saved."
        },
        "fhirconnect.openfhir.bootstrapFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder that openFHIR reads as its bootstrap folder (mounted as `/app/bootstrap`), absolute or relative to the first workspace folder. Empty: the first workspace folder. Files the engine cannot load are reported on the files of this folder."
        },
        "fhirconnect.openfhir.format": {
          "type": "string",
          "enum": [
            "canonical",
            "flat"
          ],
          "default": "canonical",
          "description": "Format of the openEHR Composition that Run Mapping to openEHR returns."
        },
        "fhirconnect.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the FHIRConnect language server."
        }
      }
    },
    "keybindings": [
      {
        "command": "fhirconnect.goToArchetype",
        "key": "ctrl+alt+f12",
        "mac": "cmd+alt+f12",
        "when": "editorTextFocus && fhirconnect.isMapping"
      },
      {
        "command": "fhirconnect.peekArchetype",
        "key": "ctrl+shift+alt+f12",
        "mac": "cmd+shift+alt+f12",
        "when": "editorTextFocus && fhirconnect.isMapping"
      },
      {
        "command": "fhirconnect.showMappingContext",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && fhirconnect.isMapping"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "fhirconnect.goToArchetype",
          "when": "fhirconnect.isMapping",
          "group": "navigation@1.5"
        },
        {
          "command": "fhirconnect.showMappingContext",
          "when": "fhirconnect.isMapping",
          "group": "navigation@1.6"
        },
        {
          "command": "fhirconnect.openfhir.runToOpenEhr",
          "when": "fhirconnect.openfhirInput == fhir",
          "group": "fhirconnect@1"
        },
        {
          "command": "fhirconnect.openfhir.runToFhir",
          "when": "fhirconnect.openfhirInput == composition",
          "group": "fhirconnect@2"
        }
      ],
      "commandPalette": [
        {
          "command": "fhirconnect.goToArchetype",
          "when": "fhirconnect.isMapping"
        },
        {
          "command": "fhirconnect.peekArchetype",
          "when": "fhirconnect.isMapping"
        },
        {
          "command": "fhirconnect.showMappingContext",
          "when": "fhirconnect.isMapping"
        },
        {
          "command": "fhirconnect.refreshMappingContext",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "fhirconnect.refreshMappingContext",
          "when": "view == fhirconnect.mappingContext",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "fhirconnect.openfhir.runToOpenEhr",
          "when": "fhirconnect.openfhirInput == fhir",
          "group": "navigation@10"
        },
        {
          "command": "fhirconnect.openfhir.runToFhir",
          "when": "fhirconnect.openfhirInput == composition",
          "group": "navigation@11"
        }
      ],
      "explorer/context": [
        {
          "command": "fhirconnect.openfhir.runToOpenEhr",
          "when": "resourceExtname == .json",
          "group": "fhirconnect@1"
        },
        {
          "command": "fhirconnect.openfhir.runToFhir",
          "when": "resourceExtname == .json",
          "group": "fhirconnect@2"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "fhirconnect.mappingContext",
          "name": "FHIRConnect Mapping Context",
          "icon": "$(list-tree)",
          "contextualTitle": "FHIRConnect"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fhirconnect.mappingContext",
        "contents": "Open a FHIRConnect mapping file and place the cursor in a method to see what it resolves to, which extensions change it and which contexts and slots use the file."
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build -- --production"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-uri": "3.0.8",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
