{
  "name": "vscode-fhir-connect",
  "displayName": "FHIRConnect",
  "description": "Editing support for FHIRConnect openEHR <-> FHIR mapping files: validation, completion, hover documentation and outline.",
  "version": "0.2.0",
  "publisher": "damoca",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/damoca/vscode-fhir-connect.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "FHIRConnect",
    "FHIR",
    "openEHR",
    "mapping",
    "yaml"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fhirconnect.newMapping",
        "title": "New Mapping File",
        "category": "FHIRConnect"
      }
    ],
    "configuration": {
      "title": "FHIRConnect",
      "properties": {
        "fhirconnect.validation.enable": {
          "type": "boolean",
          "default": true,
          "description": "Report FHIRConnect grammar problems (unknown keys, missing required keys, invalid values) in mapping files."
        },
        "fhirconnect.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the FHIRConnect language server."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build -- --production"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-uri": "3.0.8",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
